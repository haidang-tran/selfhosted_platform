# Staging environment variables
# Copy this file to .env and fill in actual values — DO NOT commit .env

# Application
APP_ENV=staging
APP_SECRET_KEY=change_me_staging_secret

# Frontend
FRONTEND_PORT=9080

# API
API_PORT=9081

# Backend / Worker
WORKER_CONCURRENCY=2

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=app_staging
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app_password

# GitHub Container Registry
GHCR_IMAGE_TAG=staging
