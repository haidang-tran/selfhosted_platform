# Production environment variables
# Copy this file to .env and fill in actual values — DO NOT commit .env

# Application
APP_ENV=production
APP_SECRET_KEY=change_me_strong_secret

# Frontend
FRONTEND_PORT=8080

# API
API_PORT=8081

# Backend / Worker
WORKER_CONCURRENCY=4

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=app_production
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app_password

# GitHub Container Registry
GHCR_IMAGE_TAG=latest
